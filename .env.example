# Database
DATABASE_URL=postgresql://keimelion:keimelion_dev_password@localhost:5432/keimelion_dev

# Server
PORT=3000
NODE_ENV=development

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3001

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# JWT
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
EMAIL_VERIFY_TOKEN_TTL_HOURS=24
# Days an unverified account can use the API after its creation (min 1, max 365, default 7).
# From the deadline on, login, refresh and every authenticated request answer 403 EMAIL_NOT_VERIFIED.
EMAIL_VERIFICATION_GRACE_DAYS=7
# Refresh token TTL in seconds (min 3600, default 2592000 = 30 days)
REFRESH_TOKEN_EXPIRES_IN=2592000
# Interval in ms between expired-token cleanup runs (min 60000, default 3600000)
JWT_CLEANUP_INTERVAL_MS=3600000
# Interval in ms between expired refresh token cleanup runs (min 60000, default 3600000)
REFRESH_TOKEN_CLEANUP_INTERVAL_MS=3600000
# Interval in ms between expired list invite cleanup runs (min 60000, default 3600000)
LIST_INVITE_CLEANUP_INTERVAL_MS=3600000
# Interval in ms between hard-delete inactive users runs (min 60000, default 3600000)
USER_HARD_DELETE_INTERVAL_MS=3600000
# Grace period in days before a soft-deleted account is permanently purged (min 1, default 30)
USER_HARD_DELETE_GRACE_DAYS=30
# Interval in ms between runs moving active accounts with no activity for 12 months to the
# inactive status (min 60000, default 86400000 = daily)
USER_INACTIVITY_STATUS_INTERVAL_MS=86400000

# FX rates — daily refresh job
# Set to "true" to run the in-process scheduler that refreshes currencies.usd_rate from the FX provider.
# Leave "false" if you drive the refresh via an external scheduler (cron / Kubernetes CronJob) hitting
# `npm run fx:refresh` instead.
FX_REFRESH_ENABLED=false
# Interval in ms between FX refresh runs when FX_REFRESH_ENABLED=true (min 60000, default 86400000 = 24h)
FX_REFRESH_INTERVAL_MS=86400000
# FX provider URL. Default: ECB daily XML (free, no API key, base EUR, re-pivoted to USD).
FX_PROVIDER_URL=https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml

# Feedback endpoint — dedicated per-IP/per-user rate limiter for POST /v1/feedback.
# Lower bounds than the global limiter because feedback is unauthenticated-friendly and spam-prone.
FEEDBACK_RATE_LIMIT_PER_MINUTE=5
FEEDBACK_RATE_LIMIT_PER_HOUR=20

# Bcrypt
BCRYPT_ROUNDS=12

# App
APP_URL=http://localhost:3000
# Public landing site: base URL of the links sent in waitlist emails (confirm, delete my signup).
# Required in production unless EMAIL_PROVIDER is log: a local URL is rejected at boot.
LANDING_URL=http://localhost:4321
# Public web app: base URL of the links sent in account emails (verify email, reset password) and in
# list collaborator invitations. Tokens travel in the URL fragment (#token=...).
# Required in production unless EMAIL_PROVIDER is log: a local URL is rejected at boot.
WEB_APP_URL=http://localhost:3002
# Backoffice: base URL of the set-password link sent to staff accounts (admin invitation, password
# reset of a moderator or admin). The Backoffice reads the token from the query string (?token=...).
# Required in production unless EMAIL_PROVIDER is log: a local URL is rejected at boot.
BACKOFFICE_URL=http://localhost:3001

# Email
# Mail provider: resend (default) or log.
# Outside production no network call is made: emails are written to the log.
# Set `log` on a production-mode environment that must not send real emails (pre-prod).
# Its logs then hold full emails, including recipients and secret links.
EMAIL_PROVIDER=resend
# Required at boot in production unless EMAIL_PROVIDER is log.
EMAIL_API_KEY=
EMAIL_FROM=noreply@keimelion.app
# Recipient of `npm run mail:test -- <template> <locale>` (local only, never set on a server).
# That script runs in production mode to send for real: EMAIL_API_KEY, EMAIL_FROM and a non-local
# LANDING_URL, WEB_APP_URL and BACKOFFICE_URL must be set.
# `npm run mail:dev` previews every email in the browser and never sends anything.
MAIL_TEST_TO=

# Image uploads
# Directory where processed webp variants are written (relative or absolute).
# Served statically by nginx in production under UPLOADS_PUBLIC_BASE_URL.
UPLOADS_DIR=./uploads
# Maximum accepted image size in bytes (default 10 MB).
UPLOADS_MAX_SIZE_BYTES=10000000
# Public base URL used to build image URLs returned in API responses.
UPLOADS_PUBLIC_BASE_URL=http://localhost:3000/uploads
# Interval in ms between orphan image cleanup runs (min 60000, default 86400000 = daily).
# Deletes images rows no item/user references, then webp files no images row references.
IMAGE_ORPHAN_CLEANUP_INTERVAL_MS=86400000
# Minimum age in hours before an unreferenced images row is deleted (min 1, default 24).
IMAGE_ORPHAN_GRACE_HOURS=24

# Waitlist double opt-in
# Validity in days of the confirmation link (min 1, default 7). Unconfirmed signups are deleted once
# it lapses, and the confirmation email announces this same delay.
WAITLIST_CONFIRMATION_VALIDITY_DAYS=7
# Interval in ms between waitlist purge runs (min 60000, default 3600000): unconfirmed signups past
# the validity window, and entries whose launch email is more than 12 months old.
WAITLIST_PURGE_INTERVAL_MS=3600000

# Affiliate links
# Interval in ms between affiliate URL generation runs (min 60000, default 900000 = 15 min).
# Each run fills item_sources.affiliate_url for sources of affiliated shops that have a strategy.
AFFILIATE_URL_GENERATION_INTERVAL_MS=900000
# Amazon Associates tag (letters, digits, _ or -). Optional: empty means no Amazon affiliate links.
AMAZON_ASSOCIATE_TAG=

# Notion integration token used by scripts/notion/notion.mjs (the Claude dev agent's Notion wrapper).
# Create an internal integration at https://www.notion.so/profile/integrations, then share the
# Keimelion backlog database with it. Not read by the API runtime — only by local Node scripts.
NOTION_TOKEN=
