# Database
DATABASE_URL=postgresql://keimelion:keimelion_dev_password@localhost:5432/keimelion_dev

# Server
PORT=3000
NODE_ENV=development

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3001

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# JWT
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
EMAIL_VERIFY_TOKEN_TTL_HOURS=24
# Refresh token TTL in seconds (min 3600, default 2592000 = 30 days)
REFRESH_TOKEN_EXPIRES_IN=2592000
# Interval in ms between expired-token cleanup runs (min 60000, default 3600000)
JWT_CLEANUP_INTERVAL_MS=3600000
# Interval in ms between expired refresh token cleanup runs (min 60000, default 3600000)
REFRESH_TOKEN_CLEANUP_INTERVAL_MS=3600000
# Interval in ms between hard-delete inactive users runs (min 60000, default 3600000)
USER_HARD_DELETE_INTERVAL_MS=3600000
# Grace period in days before a soft-deleted account is permanently purged (min 1, default 30)
USER_HARD_DELETE_GRACE_DAYS=30

# FX rates — daily refresh job
# Set to "true" to run the in-process scheduler that refreshes currencies.usd_rate from the FX provider.
# Leave "false" if you drive the refresh via an external scheduler (cron / Kubernetes CronJob) hitting
# `npm run fx:refresh` instead.
FX_REFRESH_ENABLED=false
# Interval in ms between FX refresh runs when FX_REFRESH_ENABLED=true (min 60000, default 86400000 = 24h)
FX_REFRESH_INTERVAL_MS=86400000
# FX provider URL. Default: ECB daily XML (free, no API key, base EUR, re-pivoted to USD).
FX_PROVIDER_URL=https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml

# Feedback endpoint — dedicated per-IP/per-user rate limiter for POST /v1/feedback.
# Lower bounds than the global limiter because feedback is unauthenticated-friendly and spam-prone.
FEEDBACK_RATE_LIMIT_PER_MINUTE=5
FEEDBACK_RATE_LIMIT_PER_HOUR=20

# Bcrypt
BCRYPT_ROUNDS=12

# App
APP_URL=http://localhost:3000

# Email (Resend)
EMAIL_API_KEY=
EMAIL_FROM=noreply@keimelion.com

# Image uploads
# Directory where processed webp variants are written (relative or absolute).
# Served statically by nginx in production under UPLOADS_PUBLIC_BASE_URL.
UPLOADS_DIR=./uploads
# Maximum accepted image size in bytes (default 10 MB).
UPLOADS_MAX_SIZE_BYTES=10000000
# Public base URL used to build image URLs returned in API responses.
UPLOADS_PUBLIC_BASE_URL=http://localhost:3000/uploads

# Notion integration token used by scripts/notion/notion.mjs (the Claude dev agent's Notion wrapper).
# Create an internal integration at https://www.notion.so/profile/integrations, then share the
# Keimelion backlog database with it. Not read by the API runtime — only by local Node scripts.
NOTION_TOKEN=
