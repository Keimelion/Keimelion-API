# Database
DATABASE_URL=postgresql://keimelion:keimelion_dev_password@localhost:5432/keimelion_dev

# Server
PORT=3000
NODE_ENV=development

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3001

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# JWT
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
EMAIL_VERIFY_TOKEN_TTL_HOURS=24
# Interval in ms between expired-token cleanup runs (min 60000, default 3600000)
JWT_CLEANUP_INTERVAL_MS=3600000

# Bcrypt
BCRYPT_ROUNDS=12

# App
APP_URL=http://localhost:3000

# Email (Resend)
EMAIL_API_KEY=
EMAIL_FROM=noreply@keimelion.com
